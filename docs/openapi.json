 "components": {
  "schemas": {
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "IntegrationIn": {
    "properties": {
     "provider": {
      "type": "string",
      "pattern": "^(aws|azure|entra)$",
      "title": "Provider"
     },
     "credentials": {
      "additionalProperties": true,
      "type": "object",
      "title": "Credentials",
      "description": "Stored encrypted. For the built-in simulator: {\"simulator\": {\"scale\": 1.0, \"seed\": 11}}"
     }
    },
    "type": "object",
    "required": [
     "provider",
     "credentials"
    ],
    "title": "IntegrationIn"
   },
   "QueryIn": {
    "properties": {
     "question": {
      "type": "string",
      "maxLength": 300,
      "minLength": 5,
      "title": "Question"
     }
    },
    "type": "object",
    "required": [
     "question"
    ],
    "title": "QueryIn"
   },
   "SimulationIn": {
    "properties": {
     "remediations": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array",
        "maxItems": 50
       },
       {
        "type": "null"
       }
      ],
      "title": "Remediations",
      "description": "Remediation ids to apply hypothetically. Omit to let the optimizer choose."
     },
     "budget": {
      "type": "integer",
      "maximum": 10.0,
      "minimum": 1.0,
      "title": "Budget",
      "default": 2
     },
     "target": {
      "anyOf": [
       {
        "type": "string",
        "format": "uuid"
       },
       {
        "type": "null"
       }
      ],
      "title": "Target",
      "description": "Limit the question to one crown-jewel asset"
     }
    },
    "type": "object",
    "title": "SimulationIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}